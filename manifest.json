{
  "name": "CanvasYoink",
  "description": "Adds a button to Canvas Lectures to download.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "64": "images/icon64.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": ["https://q.utoronto.ca/*", "<all_urls>"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://q.utoronto.ca/*",
        "https://kaltura-quercus-prod.utoronto.ca/*"
      ],
      "js": ["content/content.js"],
      "all_frames": true
    }
  ]
}
